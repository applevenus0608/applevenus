---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import commentsData from '../../data/comments.json';
import { getUnifiedPosts, type UnifiedPost } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getUnifiedPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: UnifiedPost;
}

const { post } = Astro.props;

// Markdown記事は事前コンパイルされたコンポーネントとして描画、microCMS記事はHTMLをそのまま埋め込む
let MarkdownContent: any = null;
if (post.source === 'markdown' && post.markdownEntry) {
  const rendered = await render(post.markdownEntry);
  MarkdownContent = rendered.Content;
}

function formatDate(d: string) {
  return d.slice(0, 10).replace(/-/g, '.');
}

// 旧サイトのコメント(移行データ)は、旧WordPress記事(legacy_id)にのみ存在する
const legacyId = post.markdownEntry?.data.legacy_id;
const comments = legacyId ? (commentsData as Record<string, any[]>)[legacyId] ?? [] : [];
---

<BaseLayout title={`${post.title} | applevenus`}>
  <article class="full">
    <div class="meta">
      <span>{formatDate(post.date)}</span>
      {post.categories.map((c) => <CategoryBadge name={c} />)}
    </div>
    <h1>{post.title}</h1>

    {post.source === 'markdown' && MarkdownContent && <MarkdownContent />}
    {post.source === 'microcms' && post.microcmsPost && (
      <Fragment set:html={post.microcmsPost.content} />
    )}

    {comments.length > 0 && (
      <div class="comments">
        <h3>{comments.length} comments (旧サイトより移行)</h3>
        {comments.map((c) => (
          <div class="comment">
            <div class="who">{c.author} — {c.date.slice(0, 10)}</div>
            <p>{c.content}</p>
          </div>
        ))}
      </div>
    )}
  </article>
</BaseLayout>
