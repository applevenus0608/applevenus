---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toSlug } from '../../utils/slug';
import { getUnifiedPosts } from '../../lib/posts';

const posts = await getUnifiedPosts();
const counts = new Map<string, { name: string; count: number }>();

for (const post of posts) {
  for (const cat of post.categories) {
    const slug = toSlug(cat);
    const entry = counts.get(slug) ?? { name: cat, count: 0 };
    entry.count += 1;
    counts.set(slug, entry);
  }
}

const sortedCategories = Array.from(counts.entries()).sort((a, b) => b[1].count - a[1].count);
---

<BaseLayout title="categories | applevenus">
  <div class="entry" style="border-bottom:none;">
    {sortedCategories.map(([slug, { name, count }]) => (
      <p style="margin: 0 0 14px;">
        <a class="badge" href={`/categories/${slug}`}>{name}</a>
        <span style="font-family:'Space Mono',monospace;font-size:12px;color:var(--muted);margin-left:8px;">{count}件</span>
      </p>
    ))}
  </div>
</BaseLayout>
